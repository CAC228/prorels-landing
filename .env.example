# Set the actual, separate landing domain before the production build.
# SITE_URL=https://your-landing-domain.ru
SITE_URL=
SITE_INDEXABLE=false
# Public webmaster verification tokens, optional.
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# Runtime only. SMTP credentials must never be build arguments or NEXT_PUBLIC_*.
# Use the sending mailbox authorised by your mail provider.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Recipient is fixed in code: zakaz@prorelsa.ru.
# Port 465 uses TLS; other ports (normally 587) require STARTTLS.
# Enable only behind a proxy that overwrites X-Real-IP and blocks direct access.
CONTACT_TRUST_PROXY=false
